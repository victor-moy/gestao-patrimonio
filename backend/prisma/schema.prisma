// Sistema de Gestão de Patrimônio — SMS Joinville
// Modelo de dados conforme RFC seção 5.2 (11 entidades de domínio
// + estoque do galpão e registro de notificações).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------
// Enums
// ----------------------------------------------------------------

enum Perfil {
  // Operador: reúne tudo o que antes eram os perfis Gestor de Patrimônio e Gestor de Manutenção
  OPERADOR
  UNIDADE
  GALPAO
  // Empresa contratada: vinculada a um prestador de serviço; só enxerga as manutenções dos contratos dele
  TERCEIRIZADA
}

enum TipoUnidade {
  UBSF
  UPA
  PA
  FARMACIA
  SERVICO_ESPECIAL
  SERVICO_VIGILANCIA
  UNIDADE_ADMINISTRATIVA
  GALPAO
  OUTRO
}

enum EstadoConservacao {
  OTIMO
  BOM
  REGULAR
  RUIM
  PESSIMO
}

enum StatusEquipamento {
  ATIVO
  EM_MANUTENCAO
  EMPRESTADO
  BAIXADO
  CEDIDO
}

// Motivo da baixa definitiva de um equipamento (leilão, extravio, etc.)
enum MotivoBaixa {
  LEILAO
  EXTRAVIO
  ROUBO
  SUBSTITUICAO
  OUTRO
}

// Ciclo de manutenção (RFC 2.3 / fluxo da Figura 6 — 7 etapas)
// Manutenção de equipamento (patrimônio) ou civil (problema em unidade, sala ou instalação, sem patrimônio)
enum TipoManutencao {
  EQUIPAMENTO
  CIVIL
}

enum CategoriaProblemaCivil {
  HIDRAULICA
  ELETRICA
  INFILTRACAO
  ALVENARIA_PINTURA
  COBERTURA
  ESQUADRIAS_VIDROS
  CLIMATIZACAO_CIVIL
  OUTROS
}

enum TipoLinhaRelatorio {
  SERVICO
  MATERIAL
}

enum StatusManutencao {
  PENDENTE_APROVACAO
  // Civil: sem contrato/saldo para encaminhar; o chamado espera providências e não vai à empresa
  AGUARDANDO_PROVIDENCIAS
  NEGADA
  AGUARDANDO_ORCAMENTO
  ORCAMENTO_REGISTRADO
  // Civil: encaminhado ao prestador, que ainda não iniciou o serviço
  AGUARDANDO_EXECUCAO
  EM_EXECUCAO
  AGUARDANDO_RETORNO
  // Civil: a Unidade confirmou que o problema foi resolvido; falta o Administrador autorizar a medição
  AGUARDANDO_MEDICAO
  CONCLUIDA
  BAIXADO
}

enum TipoSolicitacao {
  SUBSTITUICAO
  AMPLIACAO
  CESSAO_USO
  EMPRESTIMO
  RECOLHA
}

enum StatusSolicitacao {
  PENDENTE_APROVACAO
  NEGADA
  APROVADA
  APROVADA_AGUARDANDO_ATA
  AGUARDANDO_SAIDA
  AGUARDANDO_RECEBIMENTO
  AGUARDANDO_RETORNO
  AGUARDANDO_ENTREGA
  CONCLUIDA
  CANCELADA
  EXPIRADA
  // Fluxo de Ampliação/Substituição (feedback do Gestor de Patrimônio):
  // aprovação não expõe ata ao solicitante — só decide reservado ou não.
  RESERVADO
  AGUARDANDO_DISPONIBILIDADE
  AGUARDANDO_VALIDACAO
}

enum TipoMovimentacao {
  CADASTRO
  IMPORTACAO_CSV
  ENVIO_MANUTENCAO
  RETORNO_MANUTENCAO
  BAIXA
  CESSAO_USO
  EMPRESTIMO
  DEVOLUCAO_EMPRESTIMO
  RECOLHA
  DESPACHO_GALPAO
  RECEBIMENTO_GALPAO
  ATUALIZACAO_CADASTRO
}

enum OrigemRecurso {
  REGULAR
  EMENDA_PARLAMENTAR
}

enum StatusNotificacao {
  ENVIADA
  FALHA
  REGISTRADA
}

// ----------------------------------------------------------------
// Entidades
// ----------------------------------------------------------------

model Usuario {
  id          String            @id @default(uuid())
  nome        String
  email       String            @unique
  matricula   String            @unique
  senhaHash   String            @map("senha_hash")
  perfil      Perfil
  ativo       Boolean           @default(true)
  unidadeId   String?           @map("unidade_id")
  unidade     Unidade?          @relation(fields: [unidadeId], references: [id])
  // Só para o perfil TERCEIRIZADA: o prestador de serviço que o usuário representa
  prestadorId String?           @map("prestador_id")
  prestador   PrestadorServico? @relation(fields: [prestadorId], references: [id])
  criadoEm    DateTime          @default(now()) @map("criado_em")

  movimentacoes          Movimentacao[]
  movimentacoesEstoque   MovimentacaoEstoque[] @relation("MovEstoqueUsuario")
  solicitacoesCriadas    Solicitacao[]         @relation("SolicitacaoCriadaPor")
  solicitacoesDecididas  Solicitacao[]         @relation("SolicitacaoDecididaPor")
  manutencoesSolicitadas Manutencao[]          @relation("ManutencaoSolicitante")
  manutencoesDecididas   Manutencao[]          @relation("ManutencaoDecididaPor")
  logsAuditoria          LogAuditoria[]
  mensagensChat          MensagemChat[]
  leiturasConversa       LeituraConversa[]
  unidadesResponsavel    Unidade[]             @relation("UnidadeResponsavel")
  avisos                 AvisoUsuario[]

  @@index([prestadorId])
  @@map("usuario")
}

model Unidade {
  id            String      @id @default(uuid())
  nome          String      @unique
  tipo          TipoUnidade
  endereco      String?
  emailBase     String?     @map("email_base")
  // Responsável é um usuário do sistema (selecionado no cadastro)
  responsavelId String?     @map("responsavel_id")
  responsavel   Usuario?    @relation("UnidadeResponsavel", fields: [responsavelId], references: [id])
  ativo         Boolean     @default(true)
  criadoEm      DateTime    @default(now()) @map("criado_em")

  usuarios                Usuario[]
  equipamentos            Equipamento[]         @relation("EquipamentoUnidade")
  equipamentosEmprestados Equipamento[]         @relation("EquipamentoUnidadeTemporaria")
  movimentacoesOrigem     Movimentacao[]        @relation("MovimentacaoOrigem")
  movimentacoesDestino    Movimentacao[]        @relation("MovimentacaoDestino")
  movimentacoesEstoque    MovimentacaoEstoque[] @relation("MovEstoqueDestino")
  solicitacoesOrigem      Solicitacao[]         @relation("SolicitacaoOrigem")
  solicitacoesDestino     Solicitacao[]         @relation("SolicitacaoDestino")
  manutencoes             Manutencao[]
  atasEspecificas         Ata[]                 @relation("AtaUnidadeEspecifica")
  estoquesGalpao          EstoqueGalpao[]

  @@map("unidade")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String   @unique
  descricao String?
  // Cor de identificação exibida nos cards de Configurações (Figma)
  cor       String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  tipos TipoEquipamento[]

  @@map("categoria")
}

model TipoEquipamento {
  id                String    @id @default(uuid())
  codigo            String    @unique
  nome              String
  descricao         String?
  imagemUrl         String?   @map("imagem_url")
  // Preço de referência (opcional) — usado em relatórios/estimativas e como base do alerta de manutenção
  // (orçamento a partir de 50% dele); não trava nem calcula automaticamente valor de ata/aquisição
  preco             Decimal?  @db.Decimal(12, 2)
  // Tipos de manutenção que o item aceita (nenhum = não permite manutenção)
  permitePreventiva Boolean   @default(true) @map("permite_preventiva")
  permiteCorretiva  Boolean   @default(true) @map("permite_corretiva")
  categoriaId       String    @map("categoria_id")
  categoria         Categoria @relation(fields: [categoriaId], references: [id])
  criadoEm          DateTime  @default(now()) @map("criado_em")

  equipamentos   Equipamento[]
  solicitacoes   Solicitacao[]
  estoquesGalpao EstoqueGalpao[]

  @@map("tipo_equipamento")
}

model Equipamento {
  id                     String            @id @default(uuid())
  // RN01: tombamento único e imutável após o cadastro
  tombamento             String            @unique
  descricao              String
  tipoEquipamentoId      String            @map("tipo_equipamento_id")
  tipoEquipamento        TipoEquipamento   @relation(fields: [tipoEquipamentoId], references: [id])
  unidadeId              String            @map("unidade_id")
  unidade                Unidade           @relation("EquipamentoUnidade", fields: [unidadeId], references: [id])
  // RN06: durante empréstimo o tombamento permanece na origem;
  // a receptora aparece apenas como detentora temporária.
  unidadeTemporariaId    String?           @map("unidade_temporaria_id")
  unidadeTemporaria      Unidade?          @relation("EquipamentoUnidadeTemporaria", fields: [unidadeTemporariaId], references: [id])
  estadoConservacao      EstadoConservacao @map("estado_conservacao")
  status                 StatusEquipamento @default(ATIVO)
  // Preenchido quando status = BAIXADO (leilão, extravio, roubo, substituição...)
  motivoBaixa            MotivoBaixa?      @map("motivo_baixa")
  // RN10: flag de emenda parlamentar visível em relatórios e históricos
  emendaParlamentar      Boolean           @default(false) @map("emenda_parlamentar")
  dataAquisicao          DateTime?         @map("data_aquisicao")
  observacoes            String?
  // Ampliação/Substituição: solicitação que gerou este item (tombamento
  // capturado pelo Gestor ao marcar lançado no Branet) — permite listar os
  // itens de uma solicitação pra conferência/ajuste no recebimento. Exceção
  // estreita à RN01 (tombamento imutável): só estes itens, só enquanto a
  // solicitação está AGUARDANDO_VALIDACAO, podem ter o tombamento corrigido.
  criadoPorSolicitacaoId String?           @map("criado_por_solicitacao_id")
  criadoPorSolicitacao   Solicitacao?      @relation("EquipamentoCriadoPorSolicitacao", fields: [criadoPorSolicitacaoId], references: [id])
  criadoEm               DateTime          @default(now()) @map("criado_em")
  atualizadoEm           DateTime          @updatedAt @map("atualizado_em")

  movimentacoes Movimentacao[]
  manutencoes   Manutencao[]
  solicitacoes  Solicitacao[]

  @@map("equipamento")
}

// Log imutável de eventos que alteram localização/status (RF10)
model Movimentacao {
  id               String           @id @default(uuid())
  equipamentoId    String           @map("equipamento_id")
  equipamento      Equipamento      @relation(fields: [equipamentoId], references: [id])
  tipo             TipoMovimentacao
  descricao        String
  unidadeOrigemId  String?          @map("unidade_origem_id")
  unidadeOrigem    Unidade?         @relation("MovimentacaoOrigem", fields: [unidadeOrigemId], references: [id])
  unidadeDestinoId String?          @map("unidade_destino_id")
  unidadeDestino   Unidade?         @relation("MovimentacaoDestino", fields: [unidadeDestinoId], references: [id])
  usuarioId        String?          @map("usuario_id")
  usuario          Usuario?         @relation(fields: [usuarioId], references: [id])
  criadoEm         DateTime         @default(now()) @map("criado_em")

  @@map("movimentacao")
}

model Manutencao {
  id                    String                  @id @default(uuid())
  // Número sequencial legível para referenciar a manutenção (MAN-0001)
  numero                Int                     @unique @default(autoincrement())
  tipo                  TipoManutencao          @default(EQUIPAMENTO)
  // Nulo na manutenção civil; Restrict preserva o histórico se o equipamento for excluído
  equipamentoId         String?                 @map("equipamento_id")
  equipamento           Equipamento?            @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  // Civil: local afetado, tipo de problema e fotos (caminhos em /uploads/solicitacoes, protegidos)
  localAfetado          String?                 @map("local_afetado")
  categoriaCivil        CategoriaProblemaCivil? @map("categoria_civil")
  fotos                 String[]                @default([])
  // Civil: motivo de aguardar providências, contestação da Unidade e autorização da medição
  // ("problema resolvido" é a confirmação da Unidade; a medição é autorizada pelo Administrador)
  motivoPendencia       String?                 @map("motivo_pendencia")
  // Civil: o que o Administrador pediu para ajustar na finalização informada pelo prestador
  motivoAjuste          String?                 @map("motivo_ajuste")
  contestacaoUnidade    String?                 @map("contestacao_unidade")
  conferidoMedicaoEm    DateTime?               @map("conferido_medicao_em")
  conferidoMedicaoPorId String?                 @map("conferido_medicao_por_id")
  unidadeId             String                  @map("unidade_id")
  unidade               Unidade                 @relation(fields: [unidadeId], references: [id])
  solicitanteId         String                  @map("solicitante_id")
  solicitante           Usuario                 @relation("ManutencaoSolicitante", fields: [solicitanteId], references: [id])
  descricaoProblema     String                  @map("descricao_problema")
  // Nome dado por quem abre o pedido, para reconhecê-lo nas listas (opcional; sem ele vale o nome do equipamento)
  titulo                String?                 @db.VarChar(80)
  // Legado: a abertura não pede mais justificativa; mantida para os chamados antigos
  justificativa         String?
  status                StatusManutencao        @default(PENDENTE_APROVACAO)
  motivoNegacao         String?                 @map("motivo_negacao")
  decididoPorId         String?                 @map("decidido_por_id")
  decididoPor           Usuario?                @relation("ManutencaoDecididaPor", fields: [decididoPorId], references: [id])
  contratoId            String?                 @map("contrato_id")
  contrato              Contrato?               @relation(fields: [contratoId], references: [id])
  // Item do contrato (serviço + escopo) que cobre esta manutenção; o contrato acima é o dele
  contratoItemId        String?                 @map("contrato_item_id")
  contratoItem          ContratoItem?           @relation(fields: [contratoItemId], references: [id])
  orcamentoValor        Decimal?                @map("orcamento_valor") @db.Decimal(12, 2)
  orcamentoDescricao    String?                 @map("orcamento_descricao")
  // Laudo de baixa (RF16)
  laudoBaixa            String?                 @map("laudo_baixa")
  // RN11: confirmação dupla de retorno
  confirmadoUnidade     Boolean                 @default(false) @map("confirmado_unidade")
  confirmadoGestor      Boolean                 @default(false) @map("confirmado_gestor")
  estadoPosManutencao   EstadoConservacao?      @map("estado_pos_manutencao")
  custoFinal            Decimal?                @map("custo_final") @db.Decimal(12, 2)
  dataEnvio             DateTime?               @map("data_envio")
  dataConclusao         DateTime?               @map("data_conclusao")
  criadoEm              DateTime                @default(now()) @map("criado_em")
  atualizadoEm          DateTime                @updatedAt @map("atualizado_em")

  mensagens       MensagemChat[]
  leituras        LeituraConversa[]
  linhasRelatorio LinhaRelatorioManutencao[]
  avisos          AvisoUsuario[]

  @@index([contratoItemId])
  @@map("manutencao")
}

// Orçamento detalhado do prestador na manutenção civil: serviços e materiais com quantidade e valor
model LinhaRelatorioManutencao {
  id                 String             @id @default(uuid())
  manutencaoId       String             @map("manutencao_id")
  manutencao         Manutencao         @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  tipo               TipoLinhaRelatorio
  descricao          String
  unidadeMedida      String?            @map("unidade_medida") @db.VarChar(20)
  quantidade         Decimal            @db.Decimal(12, 3)
  // Preço final da linha: o preço SINAPI já com o desconto do item de contrato (cópia do momento do lançamento)
  valorUnitario      Decimal            @map("valor_unitario") @db.Decimal(12, 2)
  itemSinapiId       String?            @map("item_sinapi_id")
  itemSinapi         ItemSinapi?        @relation(fields: [itemSinapiId], references: [id])
  codigoSinapi       String?            @map("codigo_sinapi") @db.VarChar(20)
  precoSinapi        Decimal?           @map("preco_sinapi") @db.Decimal(12, 2)
  descontoPercentual Decimal?           @map("desconto_percentual") @db.Decimal(5, 2)
  criadoEm           DateTime           @default(now()) @map("criado_em")

  @@index([manutencaoId])
  @@index([itemSinapiId])
  @@map("linha_relatorio_manutencao")
}

// Tabela de referência SINAPI (preços de serviços e materiais da construção civil). Global, não por contrato.
model ItemSinapi {
  id         String             @id @default(uuid())
  codigo     String             @unique @db.VarChar(20)
  descricao  String
  unidade    String             @db.VarChar(20)
  tipo       TipoLinhaRelatorio
  preco      Decimal            @db.Decimal(12, 2)
  // Mês da tabela de onde veio o preço (AAAA-MM)
  referencia String             @db.VarChar(7)
  ativo      Boolean            @default(true)
  criadoEm   DateTime           @default(now()) @map("criado_em")

  linhas LinhaRelatorioManutencao[]

  @@map("item_sinapi")
}

model Solicitacao {
  id                        String             @id @default(uuid())
  // Número sequencial legível para referenciar a solicitação (SOL-0001)
  numero                    Int                @unique @default(autoincrement())
  tipo                      TipoSolicitacao
  status                    StatusSolicitacao  @default(PENDENTE_APROVACAO)
  unidadeOrigemId           String             @map("unidade_origem_id")
  unidadeOrigem             Unidade            @relation("SolicitacaoOrigem", fields: [unidadeOrigemId], references: [id])
  unidadeDestinoId          String?            @map("unidade_destino_id")
  unidadeDestino            Unidade?           @relation("SolicitacaoDestino", fields: [unidadeDestinoId], references: [id])
  equipamentoId             String?            @map("equipamento_id")
  equipamento               Equipamento?       @relation(fields: [equipamentoId], references: [id])
  tipoEquipamentoId         String?            @map("tipo_equipamento_id")
  tipoEquipamento           TipoEquipamento?   @relation(fields: [tipoEquipamentoId], references: [id])
  quantidade                Int?
  // Nome dado por quem abre o pedido, para reconhecê-lo nas listas (opcional; sem ele vale o nome do item)
  titulo                    String?            @db.VarChar(80)
  justificativa             String
  origemRecurso             OrigemRecurso?     @map("origem_recurso")
  ataId                     String?            @map("ata_id")
  ata                       Ata?               @relation(fields: [ataId], references: [id])
  valorVinculado            Decimal?           @map("valor_vinculado") @db.Decimal(12, 2)
  motivoNegacao             String?            @map("motivo_negacao")
  // Anexo opcional (PDF ou imagem) — comprovante de autorização/projeto interno
  anexoUrl                  String?            @map("anexo_url")
  // Cessão de Uso: nome da entidade externa (fora do município) que recebe o equipamento
  entidadeExternaNome       String?            @map("entidade_externa_nome")
  // Cessão de Uso: nº de patrimônio de cada unidade do item cedido (reservado
  // do estoque por tipo/quantidade — quem abre já informa qual(is) item(ns)
  // específico(s) do estoque serão cedidos)
  numerosPatrimonio         String[]           @default([]) @map("numeros_patrimonio")
  // Empréstimo: data final prevista, informada na criação — usada pra
  // sinalizar atraso quando a origem confirma o retorno.
  dataRetornoPrevista       DateTime?          @map("data_retorno_prevista")
  // Legado: 5 níveis de conservação avaliados no recebimento do empréstimo
  // antigo — a confirmação de recebimento foi substituída por confirmar-saída.
  estadoRecebimento         EstadoConservacao? @map("estado_recebimento")
  // Ampliação/Substituição: registro manual de que o pedido foi lançado no
  // Branet (não é integração — só um marcador de auditoria), feito pelo
  // Gestor de Patrimônio ao marcar RESERVADO → AGUARDANDO_ENTREGA, junto
  // com o número do pedido e o(s) tombamento(s) (feedback do cliente 17/08)
  numeroPedidoBranet        String?            @map("numero_pedido_branet")
  pedidoEntregaRegistradoEm DateTime?          @map("pedido_entrega_registrado_em")
  // Definida pelo Gestor de Patrimônio (não pelo solicitante), usada junto
  // com a antiguidade pra decidir prioridade entre pedidos aguardando estoque.
  // Escala 1–3, 1 = mais urgente.
  prioridade                Int?
  // Confirmação de recebimento (Unidade): OK/Não OK binário, distinto do
  // estadoRecebimento de 5 níveis usado pelo Empréstimo. Se os tombamentos
  // informados não baterem com o cadastrado, vira anomalia automaticamente.
  recebimentoOk             Boolean?           @map("recebimento_ok")
  observacaoRecebimento     String?            @map("observacao_recebimento")
  // RN07: solicitação aberta automaticamente pelo Sistema após laudo de baixa
  automatica                Boolean            @default(false)
  criadoPorId               String?            @map("criado_por_id")
  criadoPor                 Usuario?           @relation("SolicitacaoCriadaPor", fields: [criadoPorId], references: [id])
  decididoPorId             String?            @map("decidido_por_id")
  decididoPor               Usuario?           @relation("SolicitacaoDecididaPor", fields: [decididoPorId], references: [id])
  criadoEm                  DateTime           @default(now()) @map("criado_em")
  atualizadoEm              DateTime           @updatedAt @map("atualizado_em")

  itensGerados Equipamento[]     @relation("EquipamentoCriadoPorSolicitacao")
  mensagens    MensagemChat[]
  leituras     LeituraConversa[]
  avisos       AvisoUsuario[]

  @@map("solicitacao")
}

enum StatusContrato {
  ATIVO
  RENOVACAO_PENDENTE
  EXPIRADO
}

// Empresa contratada para prestar serviços (cadastro em Configurações).
model PrestadorServico {
  id       String   @id @default(uuid())
  nome     String   @unique
  cnpj     String?  @unique
  telefone String?
  email    String?
  criadoEm DateTime @default(now()) @map("criado_em")

  contratos Contrato[]
  usuarios  Usuario[]

  @@map("prestador_servico")
}

// Serviço que pode compor um contrato, ex.: "Serviço de manutenção preventiva e corretiva".
model ServicoContrato {
  id        String   @id @default(uuid())
  nome      String   @unique
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  itens ContratoItem[]

  @@map("servico_contrato")
}

// Escopo de um serviço contratado, ex.: "Preventiva", "Corretiva", "Preventiva e corretiva".
model EscopoServico {
  id              String   @id @default(uuid())
  nome            String   @unique
  descricao       String?
  // Tipos de manutenção que o escopo cobre (ao menos um); define quais itens de contrato servem a cada tipo de item
  cobrePreventiva Boolean  @default(true) @map("cobre_preventiva")
  cobreCorretiva  Boolean  @default(true) @map("cobre_corretiva")
  // Cobre manutenção civil (problemas de unidade, sala ou instalação, sem equipamento)
  cobreCivil      Boolean  @default(false) @map("cobre_civil")
  criadoEm        DateTime @default(now()) @map("criado_em")

  itens ContratoItem[]

  @@map("escopo_servico")
}

model Contrato {
  id             String           @id @default(uuid())
  numero         String           @unique
  prestadorId    String           @map("prestador_id")
  prestador      PrestadorServico @relation(fields: [prestadorId], references: [id])
  objeto         String
  // Soma dos valores dos itens, recalculada pelo servidor a cada gravação.
  // Contratos antigos, sem itens, mantêm o valor que já tinham.
  valorTotal     Decimal?         @map("valor_total") @db.Decimal(14, 2)
  status         StatusContrato   @default(ATIVO)
  vigenciaInicio DateTime         @map("vigencia_inicio")
  vigenciaFim    DateTime         @map("vigencia_fim")
  ativo          Boolean          @default(true)
  criadoEm       DateTime         @default(now()) @map("criado_em")

  itens       ContratoItem[]
  manutencoes Manutencao[]

  @@index([prestadorId])
  @@map("contrato")
}

// Serviço contratado, com valor próprio e tipo de manutenção.
model ContratoItem {
  id                 String          @id @default(uuid())
  contratoId         String          @map("contrato_id")
  contrato           Contrato        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  servicoId          String          @map("servico_id")
  servico            ServicoContrato @relation(fields: [servicoId], references: [id])
  escopoId           String          @map("escopo_id")
  escopo             EscopoServico   @relation(fields: [escopoId], references: [id])
  valor              Decimal         @db.Decimal(14, 2)
  // Desconto da proposta vencedora sobre a tabela SINAPI; vale para os chamados civis encaminhados a este item
  descontoPercentual Decimal         @default(0) @map("desconto_percentual") @db.Decimal(5, 2)
  criadoEm           DateTime        @default(now()) @map("criado_em")

  manutencoes Manutencao[]

  @@unique([contratoId, servicoId])
  @@index([servicoId])
  @@index([escopoId])
  @@map("contrato_item")
}

model Ata {
  id                  String   @id @default(uuid())
  numero              String   @unique
  fornecedor          String   @default("")
  descricao           String
  valorTotal          Decimal  @map("valor_total") @db.Decimal(14, 2)
  // RN09: saldo nunca pode ficar negativo
  saldo               Decimal  @db.Decimal(14, 2)
  vencimento          DateTime
  // Se preenchida, a ata só pode ser utilizada por esta unidade (Figma)
  unidadeEspecificaId String?  @map("unidade_especifica_id")
  unidadeEspecifica   Unidade? @relation("AtaUnidadeEspecifica", fields: [unidadeEspecificaId], references: [id])
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now()) @map("criado_em")

  solicitacoes Solicitacao[]

  @@map("ata")
}

// RF31: estoque físico por galpão (CIAD/Branet, Guanabara), por tipo de equipamento.
model EstoqueGalpao {
  id                String                @id @default(uuid())
  tipoEquipamentoId String                @map("tipo_equipamento_id")
  tipoEquipamento   TipoEquipamento       @relation(fields: [tipoEquipamentoId], references: [id])
  // Unidade (tipo GALPAO) dona deste pool de estoque
  unidadeId         String                @map("unidade_id")
  unidade           Unidade               @relation(fields: [unidadeId], references: [id])
  quantidade        Int                   @default(0)
  reservado         Int                   @default(0)
  ultimaEntradaEm   DateTime?             @map("ultima_entrada_em")
  atualizadoEm      DateTime              @updatedAt @map("atualizado_em")
  movimentacoes     MovimentacaoEstoque[]

  @@unique([tipoEquipamentoId, unidadeId])
  @@map("estoque_galpao")
}

model MovimentacaoEstoque {
  id                 String        @id @default(uuid())
  estoqueId          String        @map("estoque_id")
  estoque            EstoqueGalpao @relation(fields: [estoqueId], references: [id])
  tipo               String // ENTRADA | SAIDA
  quantidade         Int
  unidadeDestinoId   String?       @map("unidade_destino_id")
  unidadeDestino     Unidade?      @relation("MovEstoqueDestino", fields: [unidadeDestinoId], references: [id])
  atualizadoNoBranet Boolean       @default(false) @map("atualizado_no_branet")
  usuarioId          String?       @map("usuario_id")
  usuario            Usuario?      @relation("MovEstoqueUsuario", fields: [usuarioId], references: [id])
  criadoEm           DateTime      @default(now()) @map("criado_em")

  @@map("movimentacao_estoque")
}

// RNF06: log de auditoria imutável com snapshots antes/depois
model LogAuditoria {
  id          String   @id @default(uuid())
  usuarioId   String?  @map("usuario_id")
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  acao        String
  entidade    String
  entidadeId  String?  @map("entidade_id")
  dadosAntes  Json?    @map("dados_antes")
  dadosDepois Json?    @map("dados_depois")
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@map("log_auditoria")
}

// Conversa dentro de uma solicitação ou de uma manutenção (exatamente uma das duas).
// Mensagens são imutáveis: não há edição nem exclusão, só o registro cronológico.
model MensagemChat {
  id            String       @id @default(uuid())
  solicitacaoId String?      @map("solicitacao_id")
  solicitacao   Solicitacao? @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  manutencaoId  String?      @map("manutencao_id")
  manutencao    Manutencao?  @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  autorId       String       @map("autor_id")
  autor         Usuario      @relation(fields: [autorId], references: [id])
  texto         String
  criadoEm      DateTime     @default(now()) @map("criado_em")

  @@index([solicitacaoId, criadoEm])
  @@index([manutencaoId, criadoEm])
  @@map("mensagem_chat")
}

// Até quando cada usuário já leu cada conversa. Mensagens de outras pessoas mais novas que `lidaAte`
// (ou todas, se não há registro) contam como não lidas. Um registro por usuário e conversa.
model LeituraConversa {
  id            String       @id @default(uuid())
  usuarioId     String       @map("usuario_id")
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  solicitacaoId String?      @map("solicitacao_id")
  solicitacao   Solicitacao? @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  manutencaoId  String?      @map("manutencao_id")
  manutencao    Manutencao?  @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  lidaAte       DateTime     @map("lida_ate")

  @@unique([usuarioId, solicitacaoId])
  @@unique([usuarioId, manutencaoId])
  @@map("conversa_leitura")
}

// Configurações editáveis pelo Gestor de Patrimônio (chave/valor), sem mexer em código
model ConfiguracaoSistema {
  chave        String   @id
  valor        String
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("configuracao_sistema")
}

// Registro de cada envio de notificação (seção 5.3 do RFC)
model Notificacao {
  id           String            @id @default(uuid())
  destinatario String
  assunto      String
  corpo        String
  status       StatusNotificacao
  erro         String?
  criadoEm     DateTime          @default(now()) @map("criado_em")

  @@map("notificacao")
}

// Aviso in-app na Home (Atualizações): evento pontual por usuário, com leitura própria.
// Criado após a transação, nos mesmos pontos em que o e-mail é disparado (e quando o
// trabalho volta à fila do Administrador). Não espelha mensagem de chat.
model AvisoUsuario {
  id            String       @id @default(uuid())
  usuarioId     String       @map("usuario_id")
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo          String
  titulo        String
  mensagem      String
  href          String?
  solicitacaoId String?      @map("solicitacao_id")
  solicitacao   Solicitacao? @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  manutencaoId  String?      @map("manutencao_id")
  manutencao    Manutencao?  @relation(fields: [manutencaoId], references: [id], onDelete: Cascade)
  lidaEm        DateTime?    @map("lida_em")
  criadoEm      DateTime     @default(now()) @map("criado_em")

  @@index([usuarioId, lidaEm, criadoEm])
  @@index([solicitacaoId])
  @@index([manutencaoId])
  @@map("aviso_usuario")
}
