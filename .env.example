# ------------------------------------------------------------------
# Sistema de Gestão de Patrimônio — variáveis de ambiente
# Copie para .env e ajuste os valores para o seu ambiente.
# ------------------------------------------------------------------

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://sgp:sgp@localhost:5432/sgp?schema=public"
POSTGRES_USER=sgp
POSTGRES_PASSWORD=sgp
POSTGRES_DB=sgp

# API
API_PORT=3333
NODE_ENV=development

# Estas variáveis também podem ficar no GitHub (Settings › Environments › demonstracao): o deploy
# automático as lê de lá. Veja a página "Deploy e Instalação" da Wiki.

# Autenticação
# Obrigatório e com pelo menos 32 caracteres quando NODE_ENV=production (a API não inicia sem isso).
# Gere um valor forte, ex.: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-em-producao
# Duração da sessão (RF04): o token expira após esse tempo e o usuário entra de novo
JWT_EXPIRES_IN=30m

# Login pelo Keycloak da Prefeitura (OpenID Connect). Obrigatório em produção: a API não inicia sem estes cinco.
# Fora de produção, sem eles o botão de login institucional fica desligado.
# O OIDC_CLIENT_SECRET é segredo: nunca no repositório, só no .env do servidor / Secrets do GitHub.
OIDC_ISSUER=https://oauth.pmjlle.joinville.sc.gov.br/realms/pmj
OIDC_CLIENT_ID=sgp-saude
OIDC_CLIENT_SECRET=
# Exatamente como cadastrado no client do Keycloak (o /api é o prefixo do Nginx)
OIDC_REDIRECT_URI=https://sgp.exemplo.joinville.sc.gov.br/api/auth/callback
OIDC_POST_LOGOUT_URI=https://sgp.exemplo.joinville.sc.gov.br/
# Origens extras autorizadas a chamar a API pelo navegador (separadas por vírgula).
# Em produção o frontend usa o mesmo domínio (/api via Nginx), então normalmente fica vazio.
CORS_ORIGINS=

# SMTP institucional (notificações por e-mail)
SMTP_HOST=smtp.joinville.sc.gov.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SGP - Gestão de Patrimônio <sgp@joinville.sc.gov.br>"
# Em desenvolvimento, deixe desabilitado para apenas registrar as notificações
SMTP_ENABLED=false

# Porta do container web no host (80 em produção, 8080 em dev local com Docker)
WEB_PORT=8080

# Frontend (só usado em dev local sem Docker; em produção fica /api via Nginx)
VITE_API_URL=http://localhost:3333

# Grafana (profile observability): senha do admin (sem padrão, o container não sobe sem ela),
# endereço público com barra final e retenção do histórico do Prometheus
GRAFANA_PASSWORD=
GRAFANA_URL=http://localhost:8080/grafana/
PROMETHEUS_RETENTION=90d
