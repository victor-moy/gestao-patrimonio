# ------------------------------------------------------------------
# Sistema de Gestão de Patrimônio — variáveis de ambiente
# Copie para .env e ajuste os valores para o seu ambiente.
# ------------------------------------------------------------------

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://sgp:sgp@localhost:5432/sgp?schema=public"
POSTGRES_USER=sgp
POSTGRES_PASSWORD=sgp
POSTGRES_DB=sgp

# API
API_PORT=3333
NODE_ENV=development

# Autenticação
JWT_SECRET=troque-este-segredo-em-producao
# Expiração da sessão por inatividade (RF04)
JWT_EXPIRES_IN=30m

# SMTP institucional (notificações por e-mail)
SMTP_HOST=smtp.joinville.sc.gov.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SGP - Gestão de Patrimônio <sgp@joinville.sc.gov.br>"
# Em desenvolvimento, deixe desabilitado para apenas registrar as notificações
SMTP_ENABLED=false

# Porta do container web no host (80 em produção, 8080 em dev local com Docker)
WEB_PORT=8080

# Frontend (só usado em dev local sem Docker; em produção fica /api via Nginx)
VITE_API_URL=http://localhost:3333
